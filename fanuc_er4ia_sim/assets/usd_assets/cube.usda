        "red" {
            over "Geom"
            {
                over "Die" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Cube/Looks/Red>
                    color3f[] primvars:displayColor = [(0.533, 0.07, 0.053)] (
                        interpolation = "constant"
                    )
                }
            }

        }
        "yellow" {
            over "Geom"
            {
                over "Die" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Cube/Looks/Yellow>
                    color3f[] primvars:displayColor = [(0.617, 0.491, 0.147)] (
                        interpolation = "constant"
                    )
                }
            }

        }
    }
}

